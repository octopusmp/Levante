<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Liste Görünümü ──────────────────────────────────────────── -->
    <record id="estate_property_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Gayrimenkuller" decoration-muted="state=='sold'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="property_type"/>
                <field name="price"/>
                <field name="area_m2"/>
                <field name="bedrooms"/>
                <field name="address"/>
                <field name="state"
                       decoration-success="state=='available'"
                       decoration-warning="state=='reserved'"
                       decoration-danger="state=='sold'"/>
                <field name="website_published"/>
                <field name="website_id" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ── Form Görünümü ──────────────────────────────────────────── -->
    <record id="estate_property_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Gayrimenkul">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="available,reserved,sold"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="İlan başlığı…"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Genel Bilgiler">
                            <field name="property_type"/>
                            <field name="price" widget="monetary"
                                   options="{'currency_field': False}"/>
                            <field name="area_m2"/>
                            <field name="bedrooms"/>
                            <field name="bathrooms"/>
                        </group>
                        <group string="Yayın">
                            <field name="website_id"/>
                            <field name="website_published"/>
                            <field name="agent_id"/>
                            <field name="address"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Açıklama">
                            <field name="description" widget="html"
                                   placeholder="Gayrimenkul hakkında detaylı açıklama…"/>
                        </page>
                        <page string="Fotoğraflar">
                            <field name="cover_image" widget="image"
                                   options="{'size': [1200, 800]}"/>
                            <separator string="Galeri"/>
                            <field name="image_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="image" widget="image"
                                           options="{'size': [80, 60]}"/>
                                    <field name="caption"/>
                                </list>
                            </field>
                        </page>
                        <page string="Medya">
                            <group>
                                <field name="video_url"
                                       placeholder="https://youtu.be/... veya https://vimeo.com/..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Kanban Görünümü ────────────────────────────────────────── -->
    <record id="estate_property_kanban" model="ir.ui.view">
        <field name="name">estate.property.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="price"/>
                <field name="property_type"/>
                <field name="area_m2"/>
                <field name="state"/>
                <field name="cover_image"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <field name="cover_image" widget="image"
                                   options="{'img_class': 'o_image_64_cover w-100 rounded'}"/>
                            <div class="p-2">
                                <strong><field name="name"/></strong><br/>
                                <field name="price"/> ₺ ·
                                <field name="area_m2"/> m²
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ── Arama Görünümü ─────────────────────────────────────────── -->
    <record id="estate_property_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Gayrimenkul Ara">
                <field name="name"/>
                <field name="address"/>
                <field name="agent_id"/>
                <filter string="Satışta" name="available"
                        domain="[('state','=','available')]"/>
                <filter string="Rezerve" name="reserved"
                        domain="[('state','=','reserved')]"/>
                <filter string="Satıldı" name="sold"
                        domain="[('state','=','sold')]"/>
                <separator/>
                <filter string="Yayında" name="published"
                        domain="[('website_published','=',True)]"/>
                <group expand="0" string="Grupla">
                    <filter string="Tür" name="group_type"
                            context="{'group_by':'property_type'}"/>
                    <filter string="Durum" name="group_state"
                            context="{'group_by':'state'}"/>
                    <filter string="Website" name="group_website"
                            context="{'group_by':'website_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Action ─────────────────────────────────────────────────── -->
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Gayrimenkuller</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_available': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                İlk gayrimenkulünüzü ekleyin
            </p>
            <p>Yeni bir ilan oluşturun ve satışa çıkarın.</p>
        </field>
    </record>

</odoo>
